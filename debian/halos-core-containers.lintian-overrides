# Lintian is a required check on this repo (branch protection: `checks / lintian`).
# Reproduce a failure locally the way CI does:
#
#   ./tools/build-all.sh
#   lintian --info --display-info --fail-on error,warning build/*.deb
#
# Each tag below is suppressed with a reason that can be checked against the
# tree, so the next one has to be judged rather than absorbed into a blanket.
#
# The line-qualified entries below drift if a maintainer script gains a line
# above them. That is loud, not silent: lintian then emits `mismatched-override`
# (a warning, so the check fails) alongside the tag itself. The one case that
# does pass quietly is a tag that stops being emitted at all -- the override
# becomes `unused-override`, which is info-level.

# The CA-download endpoints are CGI shell scripts named after the URL path that
# serves them, so a cert endpoint is a file called halos-ca.crt. busybox httpd
# names the interpreter itself (`*.crt:/bin/sh`, `*.mobileconfig:/bin/sh` in
# assets/ca-download/httpd.conf), so the execute bit is never consulted. They
# are 0755 in the source tree and land 0644 because the asset rule in
# debian/rules installs everything that is not *.sh at 644; the docroot is
# bind-mounted read-only, so the mode difference costs nothing.
halos-core-containers: script-not-executable [var/lib/container-apps/halos-core-containers/assets/ca-download/www/halos-ca.crt]
halos-core-containers: script-not-executable [var/lib/container-apps/halos-core-containers/assets/ca-download/www/ca/halos-ca.crt]
halos-core-containers: script-not-executable [var/lib/container-apps/halos-core-containers/assets/ca-download/www/ca/halos-ca.mobileconfig]

# Sourced with `.`, never executed, so an execute bit would only invite running
# them directly. Sourcing sites differ per library: lib-hostnames from
# prestart.sh, reload-oidc-clients, halos-manage-certs and halos-resolve-domain;
# lib-oidc-clients from prestart.sh and reload-oidc-clients; lib-ca from
# prestart.sh and halos-manage-certs.
halos-core-containers: script-not-executable [usr/lib/halos-core-containers/lib-ca.sh]
halos-core-containers: script-not-executable [usr/lib/halos-core-containers/lib-hostnames.sh]
halos-core-containers: script-not-executable [usr/lib/halos-core-containers/lib-oidc-clients.sh]

# Neither is typed by anyone. reload-oidc-clients is the ExecStart of
# halos-oidc-clients-reload.service; configure-container-routing has no caller
# in this repo -- it is the ExecStartPre of the container-app units that
# container-packaging-tools generates, and is also called from
# assets/traefik/generate-routing-labels.sh.
halos-core-containers: no-manual-page [usr/bin/configure-container-routing]
halos-core-containers: no-manual-page [usr/bin/reload-oidc-clients]

# The three calls lintian flags, all against this package's own unit. (The
# scripts hold five systemctl calls; the two bare `daemon-reload`s at
# postinst:64 and postrm:15 are not tagged.) Every one is guarded by
# `[ -d /run/systemd/system ]`, so a pi-gen chroot build skips them. Scoped to
# the real sites rather than the whole package, so a systemctl call added to
# another maintainer script has to be judged on its own.
#
# Whether the explicit enable/disable are redundant with dh_installsystemd is
# open: https://github.com/halos-org/halos-core-containers/issues/225
halos-core-containers: maintainer-script-calls-systemctl [postinst:73]
halos-core-containers: maintainer-script-calls-systemctl [prerm:11]
halos-core-containers: maintainer-script-calls-systemctl [prerm:12]

# The helper units carry WantedBy=halos-core-containers.service rather than a
# target: they prepare the main service and have no meaning without it.
halos-core-containers: systemd-service-file-refers-to-unusual-wantedby-target halos-core-containers.service [usr/lib/systemd/system/halos-manage-certs.service]
halos-core-containers: systemd-service-file-refers-to-unusual-wantedby-target halos-core-containers.service [usr/lib/systemd/system/halos-oidc-clients-reload.service]
halos-core-containers: systemd-service-file-refers-to-unusual-wantedby-target halos-core-containers.service [usr/lib/systemd/system/halos-resolve-domain.service]

# debian/changelog is generated by CI as a single "Automated build" entry, so
# there is never a Debian bug for it to close.
halos-core-containers: initial-upload-closes-no-bugs

# debian/control carries a debtags `Tag:` field, which lintian does not know.
halos-core-containers: unknown-field Tag
