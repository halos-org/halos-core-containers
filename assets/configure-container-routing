#!/bin/bash
# configure-container-routing - Configure routing for a single container app
#
# This script is called by container services in their ExecStartPre to
# generate Traefik routing configuration before the container starts.
#
# Usage: configure-container-routing <app_id>
#        configure-container-routing --mdns-withdraw <app_id>
#
# Port-based routing: each app gets a dedicated HTTPS port from the 4430-4450
# range, assigned on first start and persisted in /etc/halos/port-registry.
# A path redirect on port 443 provides discoverability (e.g., /signalk-server/ → :4430).
#
# This script reads /etc/halos/routing.d/<app_id>.yml and generates:
# 1. Docker-compose override file in /run/halos/routing-labels/
# 2. Per-app ForwardAuth middleware in /etc/halos/traefik-dynamic.d/ (if needed)
# 3. Path redirect config in /etc/halos/traefik-dynamic.d/
# 4. HALOS_EXTERNAL_PORT in the app's runtime env directory
# 5. mDNS service records in /etc/avahi/services/ (if the app declares any)
#
# Provided by halos-core-containers. Other proxy packages (caddy, nginx)
# would provide their own implementation of this command.

set -e

# Directories can be overridden via environment variables for testing
ROUTING_DIR="${ROUTING_DIR:-/etc/halos/routing.d}"
OUTPUT_DIR="${OUTPUT_DIR:-/run/halos/routing-labels}"
MIDDLEWARE_DIR="${MIDDLEWARE_DIR:-/etc/halos/traefik-dynamic.d}"
PORT_REGISTRY="${PORT_REGISTRY:-/etc/halos/port-registry}"
AVAHI_SERVICES_DIR="${AVAHI_SERVICES_DIR:-/etc/avahi/services}"
SYSTEMCTL="${SYSTEMCTL:-systemctl}"
RUNTIME_DIR="${RUNTIME_DIR:-/run/container-apps}"
PORT_RANGE_START=4430
PORT_RANGE_END=4450

# HALOS_DOMAIN is consumed here for diagnostic logging only (all per-app
# routers are path-only). It is read from the calling unit's environment when
# available — core units load it from /run/halos/domain.env (published by
# halos-resolve-domain.service); apps not yet wired to that file may leave it
# empty, which is harmless for a log line. No longer re-derived here, to keep
# a single canonical-hostname resolver.
HALOS_DOMAIN="${HALOS_DOMAIN:-}"

log() {
    echo "[configure-container-routing] $1" >&2
}

# Parse YAML value - simple grep-based parser for our known format
yaml_get() {
    local key="$1"
    grep "^${key}:" | sed "s/^${key}:[[:space:]]*//" | sed 's/^"//' | sed 's/"$//'
}

# Parse nested YAML value
yaml_get_nested() {
    local parent="$1"
    local child="$2"
    sed -n "/^${parent}:/,/^[a-z]/p" | grep "^  ${child}:" | sed "s/^  ${child}:[[:space:]]*//" | sed "s/^[\"']//; s/[\"']$//"
}

# Parse deeply nested YAML value (3 levels)
yaml_get_deep() {
    local parent="$1"
    local child="$2"
    local grandchild="$3"
    sed -n "/^${parent}:/,/^[a-z]/p" | sed -n "/^  ${child}:/,/^  [a-z]/p" | grep "^    ${grandchild}:" | sed "s/^    ${grandchild}:[[:space:]]*//" | sed 's/^"//' | sed 's/"$//'
}

# --- Port Registry ---

# Get or assign a port for an app from the persistent registry.
# Returns the port number. Creates the registry file if needed.
get_or_assign_port() {
    local app_id="$1"

    # Ensure registry directory exists
    mkdir -p "$(dirname "${PORT_REGISTRY}")"

    # Create registry file if it doesn't exist
    [ -f "${PORT_REGISTRY}" ] || touch "${PORT_REGISTRY}"

    # Check if app already has a port
    local existing_port
    existing_port=$(grep "^${app_id}=" "${PORT_REGISTRY}" 2>/dev/null | cut -d= -f2)
    if [ -n "${existing_port}" ]; then
        echo "${existing_port}"
        return 0
    fi

    # Find next available port
    local port
    for port in $(seq ${PORT_RANGE_START} ${PORT_RANGE_END}); do
        if ! grep -q "=${port}$" "${PORT_REGISTRY}" 2>/dev/null; then
            echo "${app_id}=${port}" >> "${PORT_REGISTRY}"
            log "Assigned port ${port} to ${app_id}"
            echo "${port}"
            return 0
        fi
    done

    log "ERROR: No available ports in range ${PORT_RANGE_START}-${PORT_RANGE_END}"
    return 1
}

# Check if a routing file has custom forward auth headers
has_custom_headers() {
    local file="$1"
    grep -q "forward_auth:" "$file" 2>/dev/null && \
        grep -q "headers:" "$file" 2>/dev/null && \
        grep -qE "^[[:space:]]{6,}[A-Za-z]" "$file" 2>/dev/null
}

# Extract custom headers as key=value pairs
get_custom_headers() {
    local file="$1"
    sed -n '/^auth:/,/^[a-z]/p' "$file" | \
        sed -n '/forward_auth:/,/^  [a-z]/p' | \
        sed -n '/headers:/,/^    [a-z]/p' | \
        grep -E "^[[:space:]]{6,}[A-Za-z]" | \
        sed 's/^[[:space:]]*//' | \
        sed 's/:[[:space:]]*/=/'
}

# Generate per-app ForwardAuth middleware YAML
generate_middleware() {
    local app_id="$1"
    local routing_file="$2"
    local middleware_file="${MIDDLEWARE_DIR}/authelia-${app_id}.yml"

    log "Generating middleware for ${app_id}"

    local headers=""
    while IFS='=' read -r authelia_header app_header; do
        if [ -n "${authelia_header}" ]; then
            headers="${headers}
          - ${authelia_header}"
        fi
    done < <(get_custom_headers "$routing_file")

    cat > "${middleware_file}" << EOF
# Per-app ForwardAuth middleware for ${app_id}
# Auto-generated by configure-container-routing

http:
  middlewares:
    authelia-${app_id}:
      forwardAuth:
        address: "http://authelia:9091/sso/api/authz/forward-auth"
        trustForwardHeader: true
        authResponseHeaders:${headers}
EOF

    chmod 644 "${middleware_file}"
    log "Created middleware: ${middleware_file}"
}

# Generate path redirect config on websecure entrypoint
generate_path_redirect() {
    local app_id="$1"
    local external_port="$2"
    local redirect_file="${MIDDLEWARE_DIR}/redirect-${app_id}.yml"

    log "Generating path redirect /${app_id}/ → :${external_port}"

    cat > "${redirect_file}" << EOF
# Path redirect for ${app_id}: /${app_id}/ → :${external_port}/
# Auto-generated by configure-container-routing
# Path-only routing: any inbound Host on /${app_id}/* redirects via the
# regex capture (Host preserved). Auth gates at the per-app ForwardAuth
# or app-internal OIDC, not at the Traefik router level.

http:
  routers:
    redirect-${app_id}-https:
      rule: "PathPrefix(\`/${app_id}/\`)"
      entrypoints:
        - websecure
      tls: {}
      middlewares:
        - redirect-${app_id}
      service: noop@internal
      priority: 100
    redirect-${app_id}-bare:
      rule: "Path(\`/${app_id}\`)"
      entrypoints:
        - websecure
      tls: {}
      middlewares:
        - add-slash-${app_id}
      service: noop@internal
      priority: 101
    redirect-${app_id}-http:
      rule: "PathPrefix(\`/${app_id}/\`)"
      entrypoints:
        - web
      middlewares:
        - redirect-to-https
      service: noop@internal
      priority: 100
    redirect-${app_id}-bare-http:
      rule: "Path(\`/${app_id}\`)"
      entrypoints:
        - web
      middlewares:
        - redirect-to-https
      service: noop@internal
      priority: 101
  middlewares:
    redirect-${app_id}:
      redirectRegex:
        regex: "^https://([^/]+)/${app_id}/(.*)"
        replacement: "https://\${1}:${external_port}/\${2}"
        permanent: false
    add-slash-${app_id}:
      redirectRegex:
        regex: "^https://([^/]+)/${app_id}$"
        replacement: "https://\${1}/${app_id}/"
        permanent: false
EOF

    chmod 644 "${redirect_file}"
    log "Created path redirect: ${redirect_file}"
}

# Write HALOS_EXTERNAL_PORT to the app's runtime env directory
write_external_port() {
    local app_id="$1"
    local package_name="$2"
    local external_port="$3"

    # Runtime env is at /run/container-apps/<package_name>/
    local runtime_dir="${RUNTIME_DIR}/${package_name}"
    local port_file="${runtime_dir}/external-port.env"

    mkdir -p "${runtime_dir}"
    echo "HALOS_EXTERNAL_PORT=${external_port}" > "${port_file}"
    chmod 644 "${port_file}"
    log "Wrote HALOS_EXTERNAL_PORT=${external_port} to ${port_file}"
}

# Generate docker-compose override with Traefik labels
generate_override() {
    local routing_file="$1"
    local external_port="$2"

    # Parse routing.yml
    local app_id
    local service_name
    local port
    local backend_type
    local auth_mode

    app_id=$(yaml_get "app_id" < "$routing_file")
    service_name=$(yaml_get_deep "routing" "backend" "service" < "$routing_file")
    port=$(yaml_get_deep "routing" "backend" "port" < "$routing_file")
    backend_type=$(yaml_get_deep "routing" "backend" "type" < "$routing_file")
    backend_scheme=$(yaml_get_deep "routing" "backend" "scheme" < "$routing_file")
    auth_mode=$(yaml_get_nested "auth" "mode" < "$routing_file")

    # Validate required fields
    if [ -z "${app_id}" ]; then
        log "ERROR: Missing app_id in ${routing_file}"
        return 1
    fi

    if [ -z "${service_name}" ]; then
        log "ERROR: Missing routing.backend.service in ${routing_file}"
        return 1
    fi

    if [ -z "${port}" ]; then
        log "ERROR: Missing routing.backend.port in ${routing_file}"
        return 1
    fi

    # Default values
    [ -z "${backend_type}" ] && backend_type="container"
    [ -z "${auth_mode}" ] && auth_mode="forward_auth"

    local entrypoint="app-${external_port}"
    log "Processing ${app_id}: entrypoint=${entrypoint}, backend_port=${port}, auth=${auth_mode}"

    # Determine middleware chain. strip-hsts is always included to neutralize
    # backends that emit Strict-Transport-Security (e.g., Signal K Server's
    # default helmet config). Once a browser caches HSTS for <device>.local,
    # every cert error on that host becomes non-overridable — no "Proceed"
    # link, only the `thisisunsafe` keystroke. Stripping at the proxy edge
    # keeps .local devices usable with click-through certs.
    local mw_chain="strip-hsts@file"
    if [ "${auth_mode}" = "forward_auth" ]; then
        if has_custom_headers "$routing_file"; then
            generate_middleware "${app_id}" "$routing_file"
            mw_chain="${mw_chain},authelia-${app_id}@file"
        else
            mw_chain="${mw_chain},authelia@file"
        fi
    fi
    local middleware_label="      traefik.http.routers.${app_id}-secure.middlewares: \"${mw_chain}\""

    # Determine backend configuration
    local scheme="${backend_scheme:-http}"
    local backend_label
    local scheme_label=""
    local transport_label=""
    if [ "${backend_type}" = "host" ]; then
        backend_label="      traefik.http.services.${app_id}.loadbalancer.server.url: \"${scheme}://host.docker.internal:${port}\""
    else
        backend_label="      traefik.http.services.${app_id}.loadbalancer.server.port: \"${port}\""
        if [ "${scheme}" = "https" ]; then
            scheme_label="      traefik.http.services.${app_id}.loadbalancer.server.scheme: \"https\""
            transport_label="      traefik.http.services.${app_id}.loadbalancer.serversTransport: \"insecure@file\""
        fi
    fi

    # Generate override file — routers on dedicated entrypoint
    local override_file="${OUTPUT_DIR}/${app_id}.yml"

    cat > "${override_file}" << EOF
# Docker-compose override with Traefik labels for ${app_id}
# Auto-generated by configure-container-routing
# Source: ${routing_file}
# External port: ${external_port} (entrypoint: ${entrypoint})

services:
  ${service_name}:
    labels:
      traefik.enable: "true"
      # HTTPS router on dedicated entrypoint
      traefik.http.routers.${app_id}-secure.rule: "PathPrefix(\`/\`)"
      traefik.http.routers.${app_id}-secure.entrypoints: "${entrypoint}"
      traefik.http.routers.${app_id}-secure.tls: "true"
      traefik.http.routers.${app_id}-secure.priority: "2"
${middleware_label}
      # HTTP->HTTPS redirect on same entrypoint (for clients that probe with plain HTTP).
      # Lower priority than the secure router so HTTPS requests always match the
      # authenticated router above. The noop@internal service ensures no backend
      # access if a request somehow reaches this router without being redirected.
      # NOTE: \$\$ is needed because Docker Compose interpolates $, and the heredoc
      # does not escape it further — so \$\$ becomes a literal $ in the label value.
      traefik.http.routers.${app_id}-http-redirect.rule: "PathPrefix(\`/\`)"
      traefik.http.routers.${app_id}-http-redirect.entrypoints: "${entrypoint}"
      traefik.http.routers.${app_id}-http-redirect.priority: "1"
      traefik.http.routers.${app_id}-http-redirect.middlewares: "${app_id}-http-to-https"
      traefik.http.routers.${app_id}-http-redirect.service: "noop@internal"
      traefik.http.middlewares.${app_id}-http-to-https.redirectregex.regex: "^http://(.*)"
      traefik.http.middlewares.${app_id}-http-to-https.redirectregex.replacement: "https://\$\${1}"
      traefik.http.middlewares.${app_id}-http-to-https.redirectregex.permanent: "false"
      # Backend service
${backend_label}
${scheme_label}
${transport_label}
EOF

    chmod 644 "${override_file}"
    log "Created override: ${override_file}"
}

# Reject an app id that cannot safely become a file name.
#
# app_id reaches this script from argv. `/` or `..` would put the record
# outside AVAHI_SERVICES_DIR, and the shape below matches what
# container-packaging-tools already enforces for the field.
is_valid_app_id() {
    case "$1" in
        ""|*/*|*..*) return 1 ;;
    esac
    printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9-]*$'
}

# Read the DNS-SD services an app declares under the top-level `mdns:` key.
#
# A real parser, not grep: routing.d is a proxy-agnostic interchange format that
# other producers may write, and the shapes a hand parser drops -- flow style,
# quoted scalars -- would read as "declares nothing" and withdraw a working
# record. Prints one "<type> <port>" line per service. Exit 0 with output, 3
# when the key is absent, 4 when it is present but unusable, and 5 when the
# parser cannot run at all. 5 is separate because a broken environment is not a
# bad declaration, and reporting it as one sends the reader to the wrong file.
get_mdns_services() {
    local file="$1"
    local external_port="$2"

    if ! command -v python3 >/dev/null 2>&1; then
        return 5
    fi

    python3 - "$file" "$external_port" <<'MDNS_PARSE_EOF'
import re
import sys

TYPE_RE = re.compile(r"_[A-Za-z0-9][A-Za-z0-9-]*\._(tcp|udp)\Z")

path, external_port = sys.argv[1], sys.argv[2]
try:
    import yaml
except ImportError:
    sys.exit(5)

try:
    with open(path, encoding="utf-8") as handle:
        doc = yaml.safe_load(handle)
except Exception:
    sys.exit(4)

if not isinstance(doc, dict) or "mdns" not in doc:
    sys.exit(3)

entries = doc["mdns"]
if not isinstance(entries, list) or not entries:
    sys.exit(4)

lines = []
for entry in entries:
    if not isinstance(entry, dict):
        sys.exit(4)
    service_type = entry.get("type")
    # Validated at build time too, but routing.d is editable on the device and
    # the value is interpolated into XML by root.
    if not isinstance(service_type, str) or not TYPE_RE.match(service_type):
        sys.exit(4)
    port = entry.get("port", external_port)
    if not str(port).isdigit() or not 0 < int(port) < 65536:
        sys.exit(4)
    lines.append("%s %s" % (service_type, port))

print("\n".join(lines))
MDNS_PARSE_EOF
}

# Publish the app's DNS-SD service records through avahi.
#
# For an app that does not advertise itself. Both responders bind UDP 5353 under
# host networking and both answer, so a type also published by the app is then
# advertised twice, once collision-renamed -- which is why the declaration
# belongs only to an app that has no responder of its own. Records that take the
# Traefik TLS port cannot ship as a static file either, because that port is only
# assigned here.
generate_mdns_services() {
    local app_id="$1"
    local external_port="$2"
    local routing_file="$3"

    if ! is_valid_app_id "${app_id}"; then
        log "WARNING: refusing to publish mDNS records for invalid app id '${app_id}'"
        return 1
    fi

    local service_file="${AVAHI_SERVICES_DIR}/halos-${app_id}.service"

    local services_spec
    local status
    services_spec=$(get_mdns_services "$routing_file" "$external_port") && status=0 || status=$?

    if [ "${status}" -eq 3 ]; then
        # The app declares nothing. Withdraw any record left from a previous
        # declaration; a record for a port nothing serves is worse than none.
        # A withdrawal that failed has to surface: the record is still on the
        # network, and reporting that as nothing-to-do is the bug this function
        # was just fixed for.
        withdraw_mdns_services "$app_id" || return 1
        return 0
    fi

    if [ "${status}" -eq 5 ]; then
        log "WARNING: python3 with PyYAML is required to publish mDNS records (install python3-yaml); leaving ${service_file} as is"
        return 0
    fi

    if [ "${status}" -ne 0 ]; then
        # Present but unusable. Warn and keep whatever is published: silently
        # withdrawing on a parse failure is how discovery disappears with
        # nothing to debug from.
        log "WARNING: unusable mdns declaration in ${routing_file}; leaving ${service_file} as is"
        return 0
    fi

    if ! mkdir -p "${AVAHI_SERVICES_DIR}" 2>/dev/null; then
        return 1
    fi

    local services=""
    local service_type
    local port
    while read -r service_type port; do
        [ -n "${service_type}" ] || continue
        services="${services}  <service>
    <type>${service_type}</type>
    <port>${port}</port>
  </service>
"
    done <<< "${services_spec}"

    local new_content
    new_content=$(cat <<MDNS_XML_EOF
<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Auto-generated by configure-container-routing. The app id is in the file
     name, not here: it may contain a double hyphen, which is illegal inside an
     XML comment and would make avahi reject the whole file. -->
<service-group>
  <name replace-wildcards="yes">%h</name>
${services}</service-group>
MDNS_XML_EOF
)

    if [ -f "${service_file}" ] && [ "$(cat "${service_file}")" = "${new_content}" ]; then
        log "mDNS services unchanged: ${service_file}"
        return 0
    fi

    # Written through a temp file: avahi watches this directory, and a partial
    # read is a parse failure that drops every record in the file.
    #
    # Every step is checked rather than left to `set -e`. This function is
    # called on the left of `||`, which disables `set -e` inside it -- so an
    # unchecked failure would fall through to the success log and return 0,
    # reporting a record that was never published.
    local tmp_file="${service_file}.tmp.$$"
    if ! printf '%s\n' "${new_content}" > "${tmp_file}" 2>/dev/null; then
        rm -f "${tmp_file}"
        return 1
    fi
    if ! chmod 644 "${tmp_file}" || ! mv -f "${tmp_file}" "${service_file}"; then
        rm -f "${tmp_file}"
        return 1
    fi
    log "Created mDNS services: ${service_file}"
    # Explicit, so that a future reload_avahi which can fail does not turn every
    # successful publish into a reported failure. The record is already written;
    # a stale advertisement is avahi's problem to notice, not a publish error.
    reload_avahi
    return 0
}

# Take an app's records off the network. Called on stop as well as on a run that
# finds no declaration, so the advertisement does not outlive what it points at.
withdraw_mdns_services() {
    local app_id="$1"

    if ! is_valid_app_id "${app_id}"; then
        log "WARNING: refusing to touch mDNS records for invalid app id '${app_id}'"
        return 1
    fi

    local service_file="${AVAHI_SERVICES_DIR}/halos-${app_id}.service"

    if [ -f "${service_file}" ]; then
        if ! rm -f "${service_file}"; then
            return 1
        fi
        log "Withdrew mDNS services: ${service_file}"
        reload_avahi
    fi
    return 0
}

# Ask a running avahi-daemon to re-read its services directory. Absent, stopped
# or still starting avahi is not an error: it reads the directory when it comes
# up, and watches the directory once running. --no-block so a slow reload cannot
# stall the ExecStartPre this runs in.
reload_avahi() {
    if command -v "${SYSTEMCTL}" >/dev/null 2>&1 && \
       "${SYSTEMCTL}" is-active --quiet avahi-daemon 2>/dev/null; then
        "${SYSTEMCTL}" reload --no-block avahi-daemon || log "WARNING: avahi-daemon reload failed"
    fi
}

# Main
main() {
    local app_id="$1"

    if [ "${app_id}" = "--mdns-withdraw" ]; then
        # Stop-time counterpart, run from the app unit's ExecStopPost. Takes no
        # routing config: the record must come off even when routing.d is gone.
        if [ -z "${2:-}" ]; then
            echo "Usage: configure-container-routing --mdns-withdraw <app_id>" >&2
            exit 1
        fi
        # Runs from ExecStopPost with a leading `-`, so a non-zero exit cannot
        # fail the stop; it just has to be visible in the journal.
        withdraw_mdns_services "$2" \
            || log "WARNING: could not withdraw mDNS services for $2"
        exit 0
    fi

    if [ -z "${app_id}" ]; then
        echo "Usage: configure-container-routing <app_id>" >&2
        echo "       configure-container-routing --mdns-withdraw <app_id>" >&2
        exit 1
    fi

    local routing_file="${ROUTING_DIR}/${app_id}.yml"

    if [ ! -f "${routing_file}" ]; then
        # The declaration is gone, so any record written from it is stale and
        # would answer for a port nothing serves. Only this app's record is
        # touched: reconciling every halos-*.service from one app's start would
        # let a transiently missing routing file take another app off the air.
        withdraw_mdns_services "${app_id}" \
            || log "WARNING: could not withdraw mDNS services for ${app_id}"
        log "No routing config for ${app_id} at ${routing_file}, skipping"
        exit 0
    fi

    # Ensure output directories exist
    mkdir -p "${OUTPUT_DIR}"
    mkdir -p "${MIDDLEWARE_DIR}"

    # Get package_name from routing file (for runtime env path)
    local package_name
    package_name=$(yaml_get "package_name" < "$routing_file")
    [ -z "${package_name}" ] && package_name="${app_id}"

    # Assign or retrieve persistent port
    local external_port
    external_port=$(get_or_assign_port "${app_id}")

    log "Configuring routing for ${app_id} (HALOS_DOMAIN=${HALOS_DOMAIN}, port=${external_port})"

    generate_override "${routing_file}" "${external_port}"
    generate_path_redirect "${app_id}" "${external_port}"
    write_external_port "${app_id}" "${package_name}" "${external_port}"

    # Never fatal. This runs in the app's ExecStartPre, where a non-zero exit
    # costs five restarts and then a `failed` unit that does not self-heal.
    # Trading the navigation server for a discovery record is the wrong way
    # round.
    generate_mdns_services "${app_id}" "${external_port}" "${routing_file}" \
        || log "WARNING: mDNS publication failed for ${app_id}; app start continues"
}

main "$@"
