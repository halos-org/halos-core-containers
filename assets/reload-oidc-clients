#!/bin/bash
# Merge /etc/halos/oidc-clients.d/ into Authelia's client registration and
# restart Authelia when the result changed.
#
# Run by halos-oidc-clients-reload.path whenever a snippet appears or changes,
# and usable by hand: /usr/bin/reload-oidc-clients

set -e

PACKAGE_NAME="halos-core-containers"

# Test seam: prefixes every absolute path below so the tool can run against a
# scratch layout. Empty in production.
HALOS_OIDC_ROOT="${HALOS_OIDC_ROOT:-}"

ETC_DIR="${HALOS_OIDC_ROOT}/etc/container-apps/${PACKAGE_NAME}"
LIB_DIR="${HALOS_OIDC_ROOT}/usr/lib/${PACKAGE_NAME}"
OIDC_CLIENTS_DIR="${HALOS_OIDC_ROOT}/etc/halos/oidc-clients.d"

# CONTAINER_DATA_ROOT comes from the env files postinst writes, the same
# source docker-compose.yml resolves its bind mounts from. Reconstructing it
# here is what put the registration outside the mounted volume for months.
set -a
[ -f "${ETC_DIR}/env.defaults" ] && . "${ETC_DIR}/env.defaults"
[ -f "${ETC_DIR}/env" ] && . "${ETC_DIR}/env"
set +a

if [ -z "${CONTAINER_DATA_ROOT:-}" ]; then
    echo "ERROR: CONTAINER_DATA_ROOT is not set - ${ETC_DIR}/env.defaults missing or empty." >&2
    exit 1
fi

AUTHELIA_DATA="${CONTAINER_DATA_ROOT}/authelia"
AUTHELIA_OIDC_FILE="${AUTHELIA_DATA}/oidc-clients.yml"
AUTHELIA_SECRETS_FILE="${AUTHELIA_DATA}/secrets.env"

if [ ! -f "${AUTHELIA_SECRETS_FILE}" ]; then
    echo "ERROR: Authelia secrets not found at ${AUTHELIA_SECRETS_FILE}. Start halos-core-containers first." >&2
    exit 1
fi
. "${AUTHELIA_SECRETS_FILE}"

OIDC_PRIVATE_KEY=$(cat "${AUTHELIA_DATA}/oidc_private_key.pem")

# Load the hostname list — redirect_uris are emitted for every configured DNS
# hostname (IPs excluded). Falls back to ${hostname}.local on missing config.
# shellcheck source=assets/lib-hostnames.sh
. "${LIB_DIR}/lib-hostnames.sh"
halos_load_hostnames

# shellcheck source=assets/lib-oidc-clients.sh
. "${LIB_DIR}/lib-oidc-clients.sh"

echo "Reloading OIDC clients for $(halos_canonical_hostname)..."
halos_oidc_merge_clients

if [ "${HALOS_OIDC_CHANGED}" -eq 0 ]; then
    echo "Authelia left running - nothing to apply"
    exit 0
fi

# `docker restart`, not `docker compose restart`: compose resolves the
# variables in docker-compose.yml, which only the systemd unit's
# EnvironmentFile supplies, and fails outright when run standalone.
authelia_state=$(docker inspect -f '{{.State.Running}}' authelia 2>/dev/null || echo "absent")
if [ "${authelia_state}" != "true" ]; then
    echo "Authelia is not running (${authelia_state}) - new registration applies at its next start"
    exit 0
fi

echo "Restarting Authelia..."
docker restart authelia

echo "OIDC clients reloaded successfully"
